# Copie este arquivo para .env.local e preencha só o que precisar. Nada aqui é obrigatório.
# O arquivo .env.local fica só no seu computador e o Git o ignora. Reinicie a Central depois de mudá-lo.

# Medir sites no Google PageSpeed Insights (opcional).
# Crie uma chave gratuita no Google Cloud: ative a "PageSpeed Insights API" e crie uma chave de API.
PAGESPEED_API_KEY=

# Caminho do Claude Code, só se a Central não o encontrar sozinha (opcional).
# Windows (exemplo): C:\Users\voce\.local\bin\claude.exe
# Mac ou Linux (exemplo): /home/voce/.local/bin/claude
# CLAUDE_BIN=

# Modelos usados em cada tarefa (opcional). O padrão é "sonnet" para estudo, relatório e Biblioteca.
# CENTRAL_MODELO_ESTUDO=sonnet
# CENTRAL_MODELO_RELATORIO=sonnet
# CENTRAL_MODELO_BIBLIOTECA=sonnet
